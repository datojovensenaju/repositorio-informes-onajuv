table CEM
	lineageTag: 9a2cc2e1-8b64-4100-8161-d210219eac04

	measure 'Total de Casos' = COUNTROWS('CEM')
		lineageTag: 631dfd3e-5197-4dd2-bfe0-426c52e71314

		formatStringDefinition = "### ### ###"

	measure '% MUJERES' = ```
			
			VAR MujeresFiltradas = 
			    CALCULATE(
			        COUNTROWS(CEM), 
			        KEEPFILTERS(CEM[sexo_victima] = "Mujer")
			    )
			VAR TotalEnContexto = [Total de Casos]
			
			RETURN
			COALESCE(DIVIDE(MujeresFiltradas, TotalEnContexto), 0)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 370dc3b0-8922-4d57-bde6-6d01d5f84938

	measure 'Edad promedio de victima' = CALCULATE(DIVIDE(SUM(CEM[edad_victima]),COUNTROWS(CEM)))
		formatString: 0
		lineageTag: ed067a55-91f4-429c-9f2a-3a55405e19e5

	measure 'Impusieron Denuncia' = CALCULATE(DIVIDE(CALCULATE(COUNTROWS(CEM),CEM[interpuso_denuncia]="Si"),COUNTROWS(CEM)))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 85e2d3c4-933c-4d68-9600-91d6af35f659

	measure 'Riesgo Severo' = ```
			
			VAR CasosSeveros = 
			    CALCULATE(
			        COUNTROWS(CEM), 
			        KEEPFILTERS(CEM[nivel_riesgo_victima] = "Severo")
			    )
			VAR TotalContexto = COUNTROWS(CEM)
			
			RETURN
			COALESCE(DIVIDE(CasosSeveros, TotalContexto), 0)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: a09f1399-3a87-4d13-a850-5de855506374

	measure 'Vincula de Pareja' = CALCULATE(DIVIDE(CALCULATE(COUNTROWS(CEM),CEM[vinculo_agresor_victima]="Con vínculo relacional de pareja"),COUNTROWS(CEM)))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 484382e3-10c0-4dbc-a3aa-945293c1fd57

	measure '% Casos' = ```
			
			DIVIDE(
			    [Total de Casos], 
			    [Total Segmentado], 
			    0
			)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bb13fe84-71b7-4306-8b8a-460db7b7eb67

	measure 'Total Segmentado' = ```
			
			CALCULATE(
			    COUNTROWS('CEM'), 
			    ALLSELECTED('CEM'[REGION])
			)
			```
		formatString: 0
		lineageTag: 90c0f8a7-eb80-415a-86de-705148d2c0ac

	measure Mujeres = CALCULATE(COUNTROWS(CEM),CEM[sexo_victima]="Mujer")
		formatString: 0
		lineageTag: e0cd9948-0579-4d29-a485-f44488fe4334

	measure Hombres = CALCULATE(COUNTROWS(CEM),CEM[sexo_victima]="Hombre")
		formatString: 0
		lineageTag: a268b749-4ed7-4c6b-b983-727a1727beb5

	measure '% Tentativa Feminicidio' = CALCULATE(COUNTROWS(CEM), CEM[tentativa_feminicidio]="Si")
		formatString: 0
		lineageTag: e3997283-db77-4a65-8233-47107cc27fc0

