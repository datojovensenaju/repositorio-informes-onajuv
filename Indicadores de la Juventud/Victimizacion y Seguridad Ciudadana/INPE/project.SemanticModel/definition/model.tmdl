model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Año","Rango Etario","Sexo","dimRegion","poblacion"]

annotation PBI_ProTooling = ["DevMode"]

ref table Año
ref table 'Rango Etario'
ref table Sexo
ref table dimRegion
ref table poblacion

ref cultureInfo es-MX

