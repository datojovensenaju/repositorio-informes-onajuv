table poblacion
	lineageTag: 826cd7c6-b13e-40ed-bd43-406d44844db6

	measure 'Población Penitenciaria Joven' =
			
			SUM(poblacion[casos])
		lineageTag: 33c173e8-6062-434b-b878-8ebd0d5e7336

		formatStringDefinition = "### ### ###"

	measure 'Población Sentenciada' =
			
			CALCULATE(
			    [Población Penitenciaria Joven],
			    poblacion[SITUACION_JURIDICA] = "SENTENCIADO"
			)
		formatString: 0
		lineageTag: 56112022-d08d-49a0-ae86-4d8aa8943d63

	measure '% Sentenciados' =
			
			DIVIDE(
			    [Población Sentenciada],
			    [Población Penitenciaria Joven]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: ddf06c0d-c9bf-4b2e-af68-3852e8cfbfb7

	measure 'Delito Genérico Más Frecuente' =
			
			VAR TablaDelitos =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            FILTER(
			                VALUES(
			                    poblacion[delito_generico]
			                ),
			                NOT ISBLANK(
			                    poblacion[delito_generico]
			                )
			            ),
			            "@TotalPersonas",
			                CALCULATE(
			                    SUM(poblacion[casos])
			                )
			        ),
			        [@TotalPersonas], DESC,
			        poblacion[delito_generico], ASC
			    )
			RETURN
			    CONCATENATEX(
			        TablaDelitos,
			        poblacion[delito_generico],
			        ""
			    )
		lineageTag: 92ae4b6f-c983-462e-ad31-010f1168a811

	measure 'Jóvenes de Nacionalidad Extranjera' =
			
			CALCULATE(
			    [Población Penitenciaria Joven],
			    poblacion[nacionalidad] = "EXTRANJERO"
			)
		formatString: 0
		lineageTag: 453acf73-2cec-44bd-9bef-62bbbd0002e1

	measure '% Jóvenes de Nacionalidad Extranjera' =
			
			DIVIDE(
			    [Jóvenes de Nacionalidad Extranjera],
			    [Población Penitenciaria Joven],
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: e9c278ac-d716-4fe5-a0ba-f8ea646e13a0

