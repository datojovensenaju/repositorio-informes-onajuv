	partition pronacej-SOA = m
		mode: import
		source =
				let
				  Origen = Excel.Workbook(Web.Contents("https://mineduperu.sharepoint.com/sites/DATAJOVEN/Documentos compartidos/General/POWER BI - DATO JOVEN/INDICADORES SOBRE JUVENTUD/4. Victimización y seguridad ciudadana/REGISTROS/PRONACEJ/PRONACEJ_Servicio_de_orientación_al_adolescente.xlsx"), null, true),
