				  #"Encabezados promovidos" = Table.PromoteHeaders(#"Navegación 1", [PromoteAllScalars = true]),
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos", {{"Anio", Int64.Type}, {"Mes", type text}, {"Departamento_origen", type text}, {"Departamento_infraccion", type text}, {"SOA", type text}, {"Edad", Int64.Type}, {"Estado", type text}, {"Sexo", type text}, {"Educacion", type text}, {"Nivel_consumo_drogas", type text}, {"Tipo_droga", type text}, {"Nivel_consumo_alcohol", type text}, {"Situacion_laboral", type text}, {"Situacion_juridica", type text}, {"Tipo_infraccion_generica", type text}, {"Tipo_infraccion_especifica", type text}, {"Tipo_medida", type text}, {"Duracion_medida_meses", Int64.Type}, {"Numero_hijos", Int64.Type}, {"Estado_civil_padres", type text}, {"Grupo_edad", type text}}, "es")
				in
