table pronacej-SOA
	lineageTag: fdb676f0-58f3-430d-8c50-d65352f7c065

	measure 'Total Jóvenes SOA' =
			
			COUNTROWS('pronacej-SOA')
		lineageTag: 9af6ba45-3089-4d38-acf4-73039b4a24e7

		formatStringDefinition = "# ##0"

	measure 'Edad Promedio SOA' =
			
			AVERAGE('pronacej-SOA'[Edad])
		formatString: 0
		lineageTag: 96a6db8b-98c6-4d8a-9094-6647b2e010be

	measure 'Duración Promedio Medida' =
			
			AVERAGE('pronacej-SOA'[Duracion_medida_meses])
		formatString: 0
		lineageTag: ef70e917-33a3-401f-a50a-745ba910af24

	measure '% Con Hijos' =
			
			DIVIDE(
			    CALCULATE(
			        [Total Jóvenes SOA],
			        'pronacej-SOA'[Numero_hijos] > 0
			    ),
			    [Total Jóvenes SOA]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 870d8577-3b54-40e5-a5cb-53febdb85118

