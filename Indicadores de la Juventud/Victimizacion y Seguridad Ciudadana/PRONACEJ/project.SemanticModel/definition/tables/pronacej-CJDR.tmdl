table pronacej-CJDR
	lineageTag: b95795c2-88e5-47fd-a18d-994c7718e353

	measure 'Total de Jóvenes' = ```
			COUNTROWS('pronacej-CJDR') 
			```
		lineageTag: 72fd85ca-22d8-4146-ab8e-24ff6ae71949

		formatStringDefinition = "### ##0"

	measure 'Edad Promedio' =
			
			AVERAGE('pronacej-CJDR'[Edad_Actual])
		formatString: 0
		lineageTag: 46106b34-30cb-4570-942a-e673aa7d0f64

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Sentenciados' =
			
			DIVIDE(
			    CALCULATE(
			        [Total de Jóvenes],
			        'pronacej-CJDR'[Situacion_Juridica] = "SENTENCIADO"
			    ),
			    [Total de Jóvenes]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: f14fe15d-7b6e-441d-ad06-fdd02029653d

	measure '% Consumo Drogas' =
			
			DIVIDE(
			    CALCULATE(
			        [Total de Jóvenes],
			        'pronacej-CJDR'[Nivel_consumo] <> "NO CONSUME"
			    ),
			    [Total de Jóvenes]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 9967f71b-e341-4400-b563-acc41a60f482

