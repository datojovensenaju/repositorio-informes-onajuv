table pronacej-PASPE
	lineageTag: cf254e29-52dd-49ae-b411-ffbd5251e9e4

	measure 'Total Jóvenes' =
			
			COUNTROWS('pronacej-PASPE')
		lineageTag: 419d291e-b49f-4709-8572-021624e96e85

		formatStringDefinition = "### ##0"

	measure 'Edad Promedio PASPE' =
			
			AVERAGE('pronacej-PASPE'[Edad])
		lineageTag: 63c13a41-5ef6-4d30-b4a8-bb7d0ea023f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Estudian' =
			
			DIVIDE(
			    CALCULATE(
			        [Total Jóvenes],
			        'pronacej-PASPE'[Situacion_laboral] IN {
			            "SOLO ESTUDIA",
			            "ESTUDIA Y TRABAJA"
			        }
			    ),
			    [Total Jóvenes]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c9a1f70f-88d6-463c-b3ef-46adf8c37588

	measure '% Trabajan' =
			
			DIVIDE(
			    CALCULATE(
			        [Total Jóvenes],
			        'pronacej-PASPE'[Situacion_laboral] IN {
			            "SOLO TRABAJA",
			            "ESTUDIA Y TRABAJA"
			        }
			    ),
			    [Total Jóvenes]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: bd940350-3600-4d9c-ac04-2ca7c35e05fd

