	measure 'Total heridos accidentes de transito fatales' =
			CALCULATE(
			SUM(accidenteDeTransitoFatal[VALOR]), accidenteDeTransitoFatal[CONDICION]="HERIDO")
		formatString: 0
		lineageTag: cbd4e00d-2b76-4376-a432-58ea4c309795

	measure 'total accidentes de transito' = [Total heridos accidentes de transito fatales]+[Total heridos accidentes de transito no fatales]
		formatString: 0
		lineageTag: c834189d-9e64-44ab-9cf5-b1ec9fd070a6

	measure 'Total muertos accidentes de transito fatales' =
