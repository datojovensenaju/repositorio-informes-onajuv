		isNameInferred
		sourceColumn: [FRECUENCIA]

		annotation SummarizationSetBy = Automatic

	partition Tabla_Nacional = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        datosNacionales,
				        TRIM(datosNacionales[CATEGORIA]) = "NACIONAL"
				    ),
				    "AÑO", datosNacionales[AÑO],
				    "FRECUENCIA", datosNacionales[INDICADOR],
				    "CATEGORIA", datosNacionales[CATEGORIA],
				"VALOR",
				        VAR ValorLimpio =
				            TRIM(
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            datosNacionales[VALOR],
				                            "%",
				                            ""
				                        ),
				                        "(",
				                        ""
				                    ),
				                    ")",
				                    ""
				                )
				            )
				        RETURN
				            DIVIDE(VALUE(ValorLimpio), 100),
				    "CV", datosNacionales[CV]
				)

	annotation PBI_Id = f7469490c7f24e5482bbbe24287a11b5

