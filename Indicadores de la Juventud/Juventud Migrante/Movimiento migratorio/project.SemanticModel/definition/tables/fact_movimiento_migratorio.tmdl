table fact_movimiento_migratorio
	lineageTag: c6258aaa-98be-4834-8afc-dc7a36c97fe5

	measure 'Total Movimientos' =
			
			SUM(fact_movimiento_migratorio[CANTIDADES])
		lineageTag: 5630ca92-ea70-47ff-b490-8ca75323b906

		formatStringDefinition = "### ### ###"

	measure 'Total Ingresos' =
			
			CALCULATE(
			    [Total Movimientos],
			    fact_movimiento_migratorio[TIPOMOVIMIENTO] = "INGRESO"
			)
		lineageTag: dfd8b581-c7a6-4380-bfce-2ffe51d8527d

		formatStringDefinition = "### ### ###"

	measure 'Total Salidas' =
			
			CALCULATE(
			    [Total Movimientos],
			    fact_movimiento_migratorio[TIPOMOVIMIENTO] = "SALIDA"
			)
		lineageTag: 04a32d23-d352-4ea8-b580-b1f96b7a8dfa

		formatStringDefinition = "### ### ###"

	measure 'Saldo Migratorio' =
			
			[Total Ingresos] - [Total Salidas]
		lineageTag: a2c80024-8ad0-4d1f-8a03-5307dd5beade

		formatStringDefinition = "### ### ###"

