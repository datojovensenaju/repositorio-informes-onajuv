table fact_inmigrantes
	lineageTag: c2a0e000-2222-4222-8222-000000000000

	measure 'Total Inmigrantes' =
			
			SUM(fact_inmigrantes[CANTIDADES])
		lineageTag: c2a0e101-2222-4222-8222-000000000101

		formatStringDefinition = "### ### ###"

	measure '% de la principal nacionalidad' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[PAISNACIONALIDAD],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[PAISNACIONALIDAD] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Inmigrantes] )
		lineageTag: c2a0e102-2222-4222-8222-000000000102

		formatStringDefinition = "0.0%"

	measure '% de la principal situación' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[SITUACION_MIGRATORIA],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[SITUACION_MIGRATORIA] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Inmigrantes] )
		lineageTag: c2a0e103-2222-4222-8222-000000000103

		formatStringDefinition = "0.0%"

	measure '% del principal rango' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[RANGO_EDAD],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[RANGO_EDAD] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Inmigrantes] )
		lineageTag: c2a0e104-2222-4222-8222-000000000104

		formatStringDefinition = "0.0%"

	measure 'Título principal nacionalidad' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[PAISNACIONALIDAD],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[PAISNACIONALIDAD] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_inmigrantes[PAISNACIONALIDAD] )
			VAR Pct = [% de la principal nacionalidad]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c2a0e105-2222-4222-8222-000000000105

	measure 'Título principal situación' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[SITUACION_MIGRATORIA],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[SITUACION_MIGRATORIA] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_inmigrantes[SITUACION_MIGRATORIA] )
			VAR Pct = [% de la principal situación]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c2a0e106-2222-4222-8222-000000000106

	measure 'Título principal rango' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_inmigrantes,
			                fact_inmigrantes[RANGO_EDAD],
			                "Total", [Total Inmigrantes]
			            ),
			            NOT ISBLANK ( fact_inmigrantes[RANGO_EDAD] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_inmigrantes[RANGO_EDAD] )
			VAR Pct = [% del principal rango]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c2a0e107-2222-4222-8222-000000000107

