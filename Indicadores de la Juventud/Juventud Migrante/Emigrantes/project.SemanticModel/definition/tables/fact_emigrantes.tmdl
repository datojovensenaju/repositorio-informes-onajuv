table fact_emigrantes
	lineageTag: 3e8c1f74-5a20-4b96-8d11-6c7e2a9b04f3

	measure 'Total Emigrantes' =
			
			SUM(fact_emigrantes[CANTIDADES])
		lineageTag: c1a0e101-1111-4111-8111-000000000101

		formatStringDefinition = "### ### ###"

	measure '% del principal país' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[PAISMOVIMIENTO],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[PAISMOVIMIENTO] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Emigrantes] )
		lineageTag: c1a0e102-1111-4111-8111-000000000102

		formatStringDefinition = "0.0%"

	measure '% del principal motivo' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[MOTIVOVIAJE],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[MOTIVOVIAJE] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Emigrantes] )
		lineageTag: c1a0e103-1111-4111-8111-000000000103

		formatStringDefinition = "0.0%"

	measure '% del principal rango' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[RANGO_EDAD],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[RANGO_EDAD] )
			        ),
			        [Total], DESC
			    )
			RETURN
			    DIVIDE ( MAXX ( Ranking, [Total] ), [Total Emigrantes] )
		lineageTag: c1a0e104-1111-4111-8111-000000000104

		formatStringDefinition = "0.0%"

	measure 'Título principal país' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[PAISMOVIMIENTO],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[PAISMOVIMIENTO] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_emigrantes[PAISMOVIMIENTO] )
			VAR Pct = [% del principal país]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c1a0e105-1111-4111-8111-000000000105

	measure 'Título principal motivo' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[MOTIVOVIAJE],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[MOTIVOVIAJE] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_emigrantes[MOTIVOVIAJE] )
			VAR Pct = [% del principal motivo]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c1a0e106-1111-4111-8111-000000000106

	measure 'Título principal rango' =
			VAR Ranking =
			    TOPN (
			        1,
			        FILTER (
			            SUMMARIZE (
			                fact_emigrantes,
			                fact_emigrantes[RANGO_EDAD],
			                "Total", [Total Emigrantes]
			            ),
			            NOT ISBLANK ( fact_emigrantes[RANGO_EDAD] )
			        ),
			        [Total], DESC
			    )
			VAR Nombre = MAXX ( Ranking, fact_emigrantes[RANGO_EDAD] )
			VAR Pct = [% del principal rango]
			RETURN
			    IF ( ISBLANK ( Nombre ), BLANK (), FORMAT ( Pct, "0.0%" ) & " · " & Nombre )
		lineageTag: c1a0e107-1111-4111-8111-000000000107

