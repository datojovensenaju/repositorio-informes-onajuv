annotation PBI_ProTooling = ["WebModelingEdit","DevMode"]

ref table Año
ref table 'Rango Etario'
ref table Sexo
ref table Mes
ref table dimDepartamento
ref table 'Sector Cultural'
ref table trabajadoresCulturales
ref table asistenciaLectura
ref table culturaIndigena

ref cultureInfo es-MX

