table trabajadoresCulturales
	lineageTag: 528f74a8-7d0b-481d-b56e-7fae6bc0b820

	measure 'Total jóvenes' = COUNTROWS(trabajadoresCulturales)
		formatString: 0
		lineageTag: dd658708-eed0-4823-8ca3-58ec4a53b622

	measure 'Sector cultural principal' =
			
			VAR TablaSectores =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(
			                trabajadoresCulturales[SECTOR CULTURAL]
			            ),
			            "CantidadRegistros",
			            [Total jóvenes]
			        ),
			        [CantidadRegistros],
			        DESC,
			        trabajadoresCulturales[SECTOR CULTURAL],
			        ASC
			    )
			RETURN
			    CONCATENATEX(
			        TablaSectores,
			        trabajadoresCulturales[SECTOR CULTURAL]
			            & " ("
			            & FORMAT(
			                [CantidadRegistros],
			                "#,##0"
			            )
			            & ")",
			        ""
			    )
		lineageTag: 54e0bc99-1121-4810-9235-979dca161777

	measure 'Departamento principal' =
			
			VAR TablaDepartamentos =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES(
			                trabajadoresCulturales[DEPARTAMENTO]
			            ),
			            "CantidadRegistros",
			            [Total jóvenes]
			        ),
			        [CantidadRegistros],
			        DESC,
			        trabajadoresCulturales[DEPARTAMENTO],
			        ASC
			    )
			RETURN
			    CONCATENATEX(
			        TablaDepartamentos,
			        trabajadoresCulturales[DEPARTAMENTO]
			            & " ("
			            & FORMAT(
			                [CantidadRegistros],
			                "#,##0"
			            )
			            & ")",
			        ""
			    )
		lineageTag: 5262596e-fc7b-4d9f-93f5-fa8114525c39

	measure 'Porcentaje del total' =
			
			DIVIDE(
			    [Total jóvenes],
			    CALCULATE(
			        [Total jóvenes],
			        ALLSELECTED(
			            trabajadoresCulturales
			        )
			    ),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6ed4448d-316d-408b-97b4-465fd46ef91b

