model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Año","datosNacionales","datosRegionales","actividadRealizada","Region Natural"]

annotation PBI_ProTooling = ["DevMode"]

ref table Año
ref table datosNacionales
ref table datosRegionales
ref table actividadRealizada
ref table 'Region Natural'
ref table Tabla_Nacional

ref cultureInfo es-MX

