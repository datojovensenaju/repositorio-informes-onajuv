		sourceColumn: [ACTIVIDADES]

		annotation SummarizationSetBy = Automatic

	partition Tabla_Nacional = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        datosNacionales,
				        TRIM(datosNacionales[CATEGORIA]) = "NACIONAL"
				            && NOT CONTAINSSTRING(datosNacionales[VALOR], "(¬)")
				    ),
				    "AÑO", datosNacionales[AÑO],
				    "CATEGORIA", datosNacionales[CATEGORIA],
				    "ACTIVIDADES", datosNacionales[INDICADOR],
				    "VALOR",
				        VAR ValorLimpio =
				            TRIM(
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            datosNacionales[VALOR],
				                            "%",
				                            ""
				                        ),
				                        "(",
				                        ""
				                    ),
				                    ")",
				                    ""
				                )
				            )
				        RETURN
				            DIVIDE(VALUE(ValorLimpio), 100),
				    "CV", datosNacionales[CV]
				)

	annotation PBI_Id = fa1e0f3a5fc046d883a406d726798376

