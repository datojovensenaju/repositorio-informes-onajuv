		annotation SummarizationSetBy = Automatic

	column 'NIVEL EDUCATIVO'
		lineageTag: fe5b3811-422f-468f-974e-91ae2ca5c265
		summarizeBy: none
		isNameInferred
		sourceColumn: [NIVEL EDUCATIVO]

		annotation SummarizationSetBy = Automatic

	partition Tabla_Nacional = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        datosNacionales,
				        TRIM(datosNacionales[CATEGORIA]) = "NACIONAL"
				    ),
				    "AÑO", datosNacionales[AÑO],
				    "NIVEL EDUCATIVO", datosNacionales[INDICADOR],
				    "CATEGORIA", datosNacionales[CATEGORIA],
				"VALOR",
				        VAR ValorLimpio =
				            TRIM(
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            datosNacionales[VALOR],
				                            "%",
				                            ""
				                        ),
				                        "(",
				                        ""
				                    ),
				                    ")",
				                    ""
				                )
				            )
				        RETURN
				            DIVIDE(VALUE(ValorLimpio), 100),
				    "CV", datosNacionales[CV]
				)

	annotation PBI_Id = 71ed04b314c441cb9d70f194c61ddafe

