model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Año","datosNacionales","datosRegionales","Nivel Educativo Alcanzado","Region Natural","Datos Regionales"]

annotation PBI_ProTooling = ["DevMode"]

ref table Año
ref table datosNacionales
ref table datosRegionales
ref table 'Nivel Educativo Alcanzado'
ref table 'Region Natural'
ref table 'Datos Regionales'
ref table Tabla_Nacional

ref cultureInfo es-MX

