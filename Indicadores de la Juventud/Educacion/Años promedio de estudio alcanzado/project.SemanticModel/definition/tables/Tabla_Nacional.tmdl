	partition Tabla_Nacional = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        datosNacionales,
				        TRIM(datosNacionales[CATEGORIA]) = "NACIONAL"
				    ),
				    "AÑO", datosNacionales[AÑO],
				    "CATEGORIA", datosNacionales[CATEGORIA],
				    "VALOR", datosNacionales[VALOR],
				    "VALOR_NUMERO",
				        IFERROR(
				            VALUE(
				                SUBSTITUTE(
				                    TRIM(datosNacionales[VALOR]),
				                    "%",
				                    ""
				                )
				            ),
				            BLANK()
				        ),
				    "CV", datosNacionales[CV]
				)

	annotation PBI_Id = 1df896b5cc1741528b7184c67a679e09

