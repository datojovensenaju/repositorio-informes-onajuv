table 'candidatura joven'
	lineageTag: e4cabe3f-68c9-49b0-9dcf-7c7932d0841c

	measure 'Total de Candidatos Jóvenes' = COUNTROWS('candidatura joven')
		formatString: 0
		lineageTag: 270ee59e-12c9-41ee-8fd3-3bcfb1297afd

	measure 'Total de Candidatos' = [Total de Candidatos No Jóvenes] + [Total de Candidatos Jóvenes]
		formatString: 0
		lineageTag: b5602f3b-7477-4789-adc4-c1c6ca00180a

	measure 'Porcentaje de Candidatos Jóvenes' = CALCULATE(DIVIDE('candidatura joven'[Total de Candidatos Jóvenes],[Total de Candidatos]))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 9a90b91f-8515-45a4-8eab-dab142e6cc84

	measure 'Porcentaje Mujeres Jóvenes' = ```
			DIVIDE (
			    CALCULATE (
			        COUNTROWS('candidatura joven'), 
			        'candidatura joven'[Sexo] = "Mujer"
			    ),
			    [Total de Candidatos Jóvenes]
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 93ec559e-af5e-4746-9256-26082973b759

	measure 'Porcentaje Hombres Jóvenes' = ```
			DIVIDE (
			    CALCULATE (
			        COUNTROWS('candidatura joven'), 
			        'candidatura joven'[Sexo] = "Hombre"
			    ),
			    [Total de Candidatos Jóvenes]
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 48c6f67c-1f04-4052-921f-c347b5552267

