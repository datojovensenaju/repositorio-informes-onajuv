table 'Votantes – Perú – Jóvenes'
	lineageTag: 0dfd44b1-0e97-49de-b38e-927954aa72c4

	measure 'Total de Jóvenes Votantes en Perú' = ```
			
			    CALCULATE(SUM('Votantes – Perú – Jóvenes'[Total]))
			```
		lineageTag: 864280aa-cfd3-4825-ac34-fa803a6be3df

		formatStringDefinition = "### ### ###"

	measure totalHombreVotantePerú = ```
			COALESCE(
			    CALCULATE(
			        SUM('Votantes – Perú – Jóvenes'[Total]),
			        'Sexo'[SEXO] = "HOMBRE"), 
			    "-"
			)
			```
		lineageTag: abf25709-8fd5-4024-804f-fcb712783023

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure totalMujerVotantePerú = ```
			COALESCE(
			    CALCULATE(
			        SUM('Votantes – Perú – Jóvenes'[Total]),
			        'Sexo'[SEXO] = "MUJER"
			    ), 
			    "-"
			)
			```
		lineageTag: 3802ae8a-e8aa-4a40-94d7-f2daab770a2a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'total Nuevos Votantes Nacional' =
			CALCULATE(
			        SUM('Votantes – Perú – Jóvenes'[Total]),
			        'Votantes – Perú – Jóvenes'[TipoVotante] = "Nuevo")
		formatString: 0
		lineageTag: c0304b20-1d64-4ff7-8add-9bee2b6e3fb3

	measure '% Jóvenes Departamental' =
			
			DIVIDE(
			    [Total de Jóvenes Votantes en Perú],
			    CALCULATE(
			        [Total de Jóvenes Votantes en Perú],
			        ALL('Votantes – Perú – Jóvenes')
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 84a8a941-656a-480d-9c07-3a7b39e27bf0

	measure 'Sub Header' = 0.1
		lineageTag: 4cf16f33-166d-44e9-af9a-28bf45046c88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

