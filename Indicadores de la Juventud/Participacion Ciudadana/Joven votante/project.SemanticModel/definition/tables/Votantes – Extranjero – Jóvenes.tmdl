table 'Votantes – Extranjero – Jóvenes'
	lineageTag: 37e9eae5-97b9-450c-b849-7bdef4bc24a6

	measure 'Total de Jóvenes Votantes Exterior' = ```
			
			    CALCULATE(SUM('Votantes – Extranjero – Jóvenes'[Total]))
			```
		lineageTag: e0aedb32-2653-4b55-b0a3-d0a85bb09836

		formatStringDefinition = "### ### ###"

	measure 'total Nuevos Votantes Exterior' =
			CALCULATE(
			        SUM('Votantes – Extranjero – Jóvenes'[Total]),
			        'Votantes – Extranjero – Jóvenes'[TipoVotante] = "Nuevo")
		formatString: 0
		lineageTag: c2751968-285e-47c3-b139-586dafaf46bd

	measure totalHombreVotanteExterior = ```
			COALESCE(CALCULATE(
			        SUM('Votantes – Extranjero – Jóvenes'[Total]),
			        'Sexo'[SEXO] = "HOMBRE"), 
			    "-"
			)
			```
		formatString: 0
		lineageTag: 5203b3af-5214-4c9b-8794-54dd0f7b4d0e

	measure totalMujerVotanteExterior = ```
			COALESCE(CALCULATE(
			        SUM('Votantes – Extranjero – Jóvenes'[Total]),
			        'Sexo'[SEXO] = "MUJER"), 
			    "-"
			)
			```
		formatString: 0
		lineageTag: 59a16b7e-c809-41e6-bbcb-4d844d5c43b3

	measure '% Jóvenes País' =
			
			DIVIDE(
			    [Total de Jóvenes Votantes Exterior],
			    CALCULATE(
			        [Total de Jóvenes Votantes Exterior],
			        ALL('Votantes – Extranjero – Jóvenes')
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e2392489-ea12-4c2d-b630-8daed2363e0a

