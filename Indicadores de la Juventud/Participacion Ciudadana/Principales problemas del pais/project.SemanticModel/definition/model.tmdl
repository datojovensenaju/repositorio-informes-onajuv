model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Año","datosNacionales","datosRegionales","principalProblema"]

annotation PBI_ProTooling = ["DevMode"]

ref table Año
ref table datosNacionales
ref table datosRegionales
ref table principalProblema

ref cultureInfo es-MX

