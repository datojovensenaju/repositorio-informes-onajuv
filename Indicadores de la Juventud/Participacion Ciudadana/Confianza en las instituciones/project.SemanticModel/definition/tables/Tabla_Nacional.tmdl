		isNameInferred
		sourceColumn: [INSTITUCIÓN]

		annotation SummarizationSetBy = Automatic

	partition Tabla_Nacional = calculated
		mode: import
		source =
				
				SELECTCOLUMNS(
				    FILTER(
				        datosNacionales,
				        TRIM(datosNacionales[CATEGORIA]) = "NACIONAL"
				            && NOT CONTAINSSTRING(datosNacionales[VALOR], "(¬)")
				    ),
				    "AÑO", datosNacionales[AÑO],
				    "CATEGORIA", datosNacionales[CATEGORIA],
				    "INSTITUCIÓN", datosNacionales[INDICADOR],
				    "VALOR",
				        VAR ValorLimpio =
				            TRIM(
				                SUBSTITUTE(
				                    SUBSTITUTE(
				                        SUBSTITUTE(
				                            datosNacionales[VALOR],
				                            "%",
				                            ""
				                        ),
				                        "(",
				                        ""
				                    ),
				                    ")",
				                    ""
				                )
				            )
				        RETURN
				            DIVIDE(VALUE(ValorLimpio), 100),
				    "CV", datosNacionales[CV]
				)

	annotation PBI_Id = f12d7180d0f548ab9b4daed0a8144e36

