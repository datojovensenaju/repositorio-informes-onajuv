		annotation SummarizationSetBy = Automatic

	column AÑO
		dataType: string
		lineageTag: 35887fc1-63e6-4ce1-90fe-b55e207216e7
		summarizeBy: none
		sourceColumn: AÑO

		annotation SummarizationSetBy = Automatic

	partition factPoblacionJoven = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(Web.Contents("https://mineduperu.sharepoint.com/sites/DATAJOVEN/Documentos%20compartidos/General/POWER%20BI%20-%20DATO%20JOVEN/DATOS%20DEMOGR%C3%81FICOS/Datos%20demogr%C3%A1ficos.xlsx"), null, true),
				    factPoblacionJoven_Sheet = Origen{[Item="factPoblacionJoven",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(factPoblacionJoven_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"POBLACION JOVEN", Int64.Type}})
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

