		lineageTag: cd43aa5c-a8fb-46f4-8775-36ca7ff32277
		summarizeBy: none
		sourceColumn: RANGO DE EDAD

		annotation SummarizationSetBy = Automatic

	column 'POBLACION JOVEN'
		dataType: int64
		formatString: 0
		lineageTag: 1e4315c1-47b3-4b7e-849f-7a57b5c19194
		summarizeBy: sum
		sourceColumn: POBLACION JOVEN

		annotation SummarizationSetBy = Automatic

	column SEXO
		dataType: string
		lineageTag: e267c86c-4589-4a42-ab73-6518da95447e
