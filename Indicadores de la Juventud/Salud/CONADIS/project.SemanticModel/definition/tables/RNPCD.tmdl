table RNPCD
	lineageTag: 40a9dc18-6a9e-40fe-99be-2bad41b49eda

	measure 'Total jóvenes registrados' = ```
			VAR registrados =
			COUNTROWS('RNPCD')
			RETURN
			IF(ISBLANK(COUNTROWS(RNPCD)),
			    "-",
			    registrados)
			
			
			```
		formatString: 0
		lineageTag: 9603086e-fce5-48cf-aa4b-80683627051c

	measure 'Registros activos' =
			
			CALCULATE(
			    [Total jóvenes registrados],
			    KEEPFILTERS(
			        'RNPCD'[Estado_Registro] = "Activo"
			    )
			)
		formatString: 0
		lineageTag: 89a726ca-2f1d-477a-b679-fa36dbff794d

	measure '% registros activos' =
			
			DIVIDE(
			    [Registros activos],
			    [Total jóvenes registrados],
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 0912d74d-9f48-43ee-a173-617fee3cd4f7

	measure 'Registros con gravedad severa' =
			
			CALCULATE(
			    COUNTROWS('RNPCD'),
			    KEEPFILTERS(
			        'RNPCD'[Nivel_Gravedad] = "Severo"
			    )
			)
		formatString: 0
		lineageTag: 654e0762-acbf-4726-80e4-e238bf343805

	measure '% gravedad severa' =
			
			VAR TotalRegistros =
			    COUNTROWS('RNPCD')
			
			VAR Porcentaje =
			    DIVIDE(
			        [Registros con gravedad severa],
			        TotalRegistros
			    )
			
			RETURN
			IF(
			    ISBLANK(Porcentaje),
			    "-",
			    FORMAT(Porcentaje, "0.0%"))
		lineageTag: 74757025-bcbf-4d5a-a5f9-f11bc9714cad

	measure 'Edad promedio' =
			
			AVERAGE('RNPCD'[Edad])
		lineageTag: 5b54f18e-02db-4191-813f-0cec02a71bd2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tipo de deficiencia más frecuente' =
			
			VAR TablaFrecuencias =
			    ADDCOLUMNS(
			        ALLSELECTED(
			            'DimDeficiencia'[tipo_deficiencia]
			        ),
			        "@Cantidad",
			            CALCULATE(
			                [Jóvenes por tipo de deficiencia]
			            )
			    )
			
			VAR MayorCantidad =
			    MAXX(
			        TablaFrecuencias,
			        [@Cantidad]
			    )
			
			RETURN
			IF([Total jóvenes registrados]="-",
			"-",
			    CONCATENATEX(
			        FILTER(
			            TablaFrecuencias,
			            [@Cantidad] = MayorCantidad
			        ),
			        'DimDeficiencia'[tipo_deficiencia],
			        ", "
			    ))
		lineageTag: e2c682d7-08d3-46c8-9248-f0973818d486

	measure 'Tipo de limitación más frecuente' =
			
			VAR TablaFrecuencias =
			    ADDCOLUMNS(
			        ALLSELECTED(
			            'DimLimitacion'[tipo_limitacion]
			        ),
			        "@Cantidad",
			            CALCULATE(
			                [Jóvenes por tipo de limitación]
			            )
			    )
			
			VAR MayorCantidad =
			    MAXX(
			        TablaFrecuencias,
			        [@Cantidad]
			    )
			
			RETURN
			IF([Total jóvenes registrados]="-",
			"-",
			    CONCATENATEX(
			        FILTER(
			            TablaFrecuencias,
			            [@Cantidad] = MayorCantidad
			        ),
			        'DimLimitacion'[tipo_limitacion],
			        ", "
			    ))
		lineageTag: bb7298ab-b366-49c8-ba84-9227c7d369fa

	measure '% gravedad severasadas' =
			
			VAR TotalRegistros =
			    [Total jóvenes registrados]
			
			VAR Porcentaje =
			    DIVIDE(
			        [Registros con gravedad severa],
			        TotalRegistros
			    )
			
			RETURN
			IF(
			    ISBLANK(Porcentaje),
			    "-",
			    FORMAT(Porcentaje, "0.0%"))
		lineageTag: e267df1d-0f3b-42af-9835-f938e23ce8d3

