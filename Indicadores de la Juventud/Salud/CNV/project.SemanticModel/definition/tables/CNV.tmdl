table CNV
	lineageTag: 3a62b0fb-460f-4ab4-9770-25087fe81331

	measure 'Total nacidos vivos' =
			
			VAR TotalRegistros = COUNTROWS('CNV')
			RETURN
			    IF(TotalRegistros = 0, BLANK(), TotalRegistros)
		formatString: 0
		lineageTag: b126769c-cf9f-4878-9a54-84a7d650fb0d

	measure 'Edad promedio de la madre' =
			
			VAR PromedioEdad =
			    AVERAGE('CNV'[edad])
			RETURN
			    IF(
			        ISBLANK(PromedioEdad),
			        BLANK(),
			        ROUND(PromedioEdad, 1)
			    )
		formatString: 0
		lineageTag: d1feeada-2d69-4775-b134-f4ea2c4bfc13

	measure 'Variación enero-junio 2026 vs 2025' =
			
			VAR Total2025 =
			    CALCULATE(
			        [Total nacidos vivos],
			        REMOVEFILTERS(
			            'CNV'[fecha],
			            'CNV'[anio],
			            'CNV'[mes]
			        ),
			        FILTER(
			            ALL('CNV'[fecha]),
			            'CNV'[fecha] >= DATE(2025, 1, 1)
			                && 'CNV'[fecha] < DATE(2025, 7, 1)
			        )
			    )
			VAR Total2026 =
			    CALCULATE(
			        [Total nacidos vivos],
			        REMOVEFILTERS(
			            'CNV'[fecha],
			            'CNV'[anio],
			            'CNV'[mes]
			        ),
			        FILTER(
			            ALL('CNV'[fecha]),
			            'CNV'[fecha] >= DATE(2026, 1, 1)
			                && 'CNV'[fecha] < DATE(2026, 7, 1)
			        )
			    )
			RETURN
			    IF(
			        ISBLANK(Total2025) || ISBLANK(Total2026),
			        "-",
			        DIVIDE(Total2026 - Total2025, Total2025)
			    )
		lineageTag: cb4ea057-580e-4dc1-a5c3-b7e774a70778

		formatStringDefinition = "0.00 %;-0.00 %;0.00 %"

	measure 'Registros con condición de parto conocida' =
			
			CALCULATE(
			    [Total nacidos vivos],
			    REMOVEFILTERS('CNV'[condicion_parto]),
			    KEEPFILTERS('CNV'[fecha] >= DATE(2025, 1, 1)),
			    'CNV'[condicion_parto]
			        IN {
			            "ESPONTANEO",
			            "CESAREA",
			            "INSTRUMENTADO",
			            "OTRO"
			        }
			)
		formatString: 0
		lineageTag: 22c8140f-6fb8-4d13-be42-970e440c4b23

	measure 'Nacidos vivos en partos espontáneos' =
			
			CALCULATE(
			    [Total nacidos vivos],
			    REMOVEFILTERS('CNV'[condicion_parto]),
			    KEEPFILTERS('CNV'[fecha] >= DATE(2025, 1, 1)),
			    'CNV'[condicion_parto] = "ESPONTANEO"
			)
		formatString: 0
		lineageTag: 66986e8b-59df-4f26-b327-4ec491b028d6

	measure '% nacidos vivos en partos espontáneos' =
			
			DIVIDE(
			    [Nacidos vivos en partos espontáneos],
			    [Registros con condición de parto conocida]
			)
		lineageTag: bb0b1bd5-25a3-4265-b97c-cf4978fec008

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% según condición del parto' =
			
			VAR TotalInformado =
			    CALCULATE(
			        [Total nacidos vivos],
			        REMOVEFILTERS('CNV'[condicion_parto_pb]),
			        'CNV'[condicion_parto_pb]
			            IN {
			                "ESPONTANEO",
			                "CESAREA",
			                "INSTRUMENTADO",
			                "OTRO"
			            }
			    )
			RETURN
			    DIVIDE(
			        [Total nacidos vivos],
			        TotalInformado
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: d880901e-a67c-4c9d-b939-71879c2ebd6f

	measure Medida
		lineageTag: 5be31428-eecd-4be9-8cec-c0d7c32a97fd

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure '% según edad de la madre' =
			
			DIVIDE(
			    [Total nacidos vivos],
			    CALCULATE(
			        [Total nacidos vivos],
			        REMOVEFILTERS('CNV'[edad], 'CNV'[rango_edad])
			    )
			)
		formatString: #,0.0\ %;-#,0.0\ %;#,0.0\ %
		lineageTag: 3fa2e93d-8823-494d-8009-adf10127c558

