	partition discapacidad = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(Web.Contents("https://mineduperu.sharepoint.com/sites/DATAJOVEN/Documentos compartidos/General/POWER BI - DATO JOVEN/INDICADORES SOBRE JUVENTUD/3. Salud/REGISTROS/SALUD-discapacidad.xlsx"), null, true),
				    discapacidad_Sheet = Origen{[Item="discapacidad",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(discapacidad_Sheet, [PromoteAllScalars=true]),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Encabezados promovidos","Discapacidad ","",Replacer.ReplaceText,{"gravedad"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Valor reemplazado", "COD. DANIO", each Text.Start([diagnostico_danio], 4)),
				    #"Personalizada agregada1" = Table.AddColumn(#"Personalizada agregada", "COD. ETIOLOGICO", each Text.Start([diagnostico_etiologico], 4))
				in
				    #"Personalizada agregada1"

