table discapacidad
	lineageTag: 19521537-2860-4b26-8a9f-59580db3fe77

	measure 'Total Casos' =
			
			VAR TotalCasos =
			    COUNTROWS(discapacidad)
			RETURN
			IF(
			    TotalCasos > 0,
			    TotalCasos,
			    "-"
			)
		lineageTag: 339646bd-345c-48c2-92c7-ef6d19cc5d4d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Severa' = CALCULATE([Total Casos], discapacidad[GRAVEDAD] = "Severa")
		formatString: 0
		lineageTag: 119537a8-7b4e-40fc-b044-8e2f921438a7

	measure totalHombres =
			VAR TotalHombres =
			    CALCULATE(
			        COUNTROWS(discapacidad),
			        Sexo[SEXO] = "HOMBRE"
			    )
			RETURN
			IF(
			    TotalHombres > 0,
			    TotalHombres,
			    "-"
			)
		lineageTag: bde11ba4-f727-4642-becc-6eb61d182ed6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure totalMujeres =
			VAR TotalMujeres =
			    CALCULATE(
			        COUNTROWS(discapacidad),
			        Sexo[SEXO] = "MUJER"
			    )
			RETURN
			IF(
			    TotalMujeres > 0,
			    TotalMujeres,
			    "-"
			)
		lineageTag: 284d7862-40cd-4bd6-a8de-1317a1d4c52d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure totalSeveros =
			VAR TotalSeveros =
			    CALCULATE(
			        COUNTROWS(discapacidad),
			        discapacidad[GRAVEDAD] = "Severa"
			    )
			RETURN
			IF(
			    TotalSeveros > 0,
			    TotalSeveros,
			    "-"
			)
		lineageTag: 91a2e40a-abd6-47f6-b04f-dd2ef1ba8ee6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% casos' =
			
			DIVIDE(
			    [Total Casos],
			    CALCULATE(
			        [Total Casos],
			        REMOVEFILTERS('dimRegion'),
			        REMOVEFILTERS('dimProvincia'),
			        REMOVEFILTERS('dimDistrito')
			    )
			)
		lineageTag: 4391fe6f-1d03-4d9c-bb0f-614bc1877585

		annotation PBI_FormatHint = {"isGeneralNumber":true}

