table VIH
	lineageTag: a10da4ba-ac86-4121-b7e9-b9808cd1e513

	measure 'Casos VIH' = COUNTROWS(VIH)
		lineageTag: a236162f-323d-41df-8f59-af09e6217cd2

		formatStringDefinition = "### ### ###"

	measure 'Casos Hombres' = CALCULATE([Casos VIH], VIH[sexo] = "Hombre")
		lineageTag: 908f4c6c-a2f0-4358-8237-cbbac4fcdd3d

		formatStringDefinition = "### ### ###"

	measure 'Casos Mujeres' = CALCULATE([Casos VIH], VIH[sexo] = "Mujer")
		lineageTag: b848ca5b-475e-446e-9518-b81a069c5539

		formatStringDefinition = "### ### ###"

	measure 'Casos SIDA' =
			VAR casosSida =
			CALCULATE(
			    [Casos VIH],
			    NOT ISBLANK(VIH[fecha_dx_sida])
			)
			RETURN
			IF(
			    casosSida > 0,
			    casosSida,
			    "-"
			)
		lineageTag: 0db52658-0a87-48cf-914b-e50c1cc0b15f

		formatStringDefinition = "### ### ###"

	measure '% Casos con SIDA' =
			VAR casosPorcentajeSida =
			DIVIDE(
			    CALCULATE(
			    [Casos VIH],
			    NOT ISBLANK(VIH[fecha_dx_sida])),
			    [Casos VIH]
			)
			RETURN
			IF(
			    casosPorcentajeSida > 0,
			    casosPorcentajeSida,
			    "-"
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 09948a79-8c93-411a-87f5-2a60a78ca1d5

	measure 'Edad promedio' = AVERAGE(VIH[edad])
		formatString: 0
		lineageTag: c5fc532f-e5f9-4597-b9f6-ba5641633a22

