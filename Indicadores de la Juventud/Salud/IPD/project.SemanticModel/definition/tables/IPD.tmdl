table IPD
	lineageTag: 1cf9508a-c785-4b66-b77b-ca0de3c8045a

	measure 'Total de jóvenes IPD' =
			var total=COUNTROWS(IPD)
			RETURN
			 IF(total=BLANK(),"-",total)
		formatString: 0
		lineageTag: 003b6619-2332-42c1-9ea0-b77e65ef8570

	measure 'Edad Promedio' =
			var promedio=AVERAGE('IPD'[EDAD])
			RETURN
			IF(promedio=BLANK(), "-",
			promedio)
		formatString: 0
		lineageTag: 502f52f8-5936-48c3-b663-d5e1874eeb29

	measure 'Porcentaje de nuevos ingresos' =
			VAR Nuevos = DIVIDE(CALCULATE(COUNTROWS(IPD), IPD[PERMANENCIA]="NUEVO"), [Total de jóvenes IPD])
			RETURN
			IF(
			    Nuevos>0,
			    Nuevos,
			    "-"
			    )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 65a56b36-d0e3-4362-aebc-cc4af4262cc7

	measure 'Disciplina que mas se practica' =
			VAR TopDisciplina =
			    TOPN(
			        1,
			        VALUES('IPD'[DISCIPLINA]),
			        [Total de jóvenes IPD], DESC,
			        'IPD'[DISCIPLINA], ASC
			    )
			RETURN
			IF(TopDisciplina=BLANK(),"-",    CONCATENATEX(TopDisciplina, 'IPD'[DISCIPLINA], ", "))
		lineageTag: 2274a936-3f5b-400a-8f62-3a2d4819e983

