table Miembros
	lineageTag: 6dde7c00-48da-4c2d-aedc-5dde14c514c9

	measure 'Miembros Registrados (15-29)' =
			
			CALCULATE(
			    COUNTROWS(Miembros),
			    VALUE(Miembros[Edad]) >= 15,
			    VALUE(Miembros[Edad]) <= 29
			)
		formatString: 0
		lineageTag: 7a19189a-39de-4518-9fc8-ca6cd3f88c79

	measure 'Promedio Edad' =
			ROUND(
			AVERAGEX(
			    Miembros,
			    VALUE(Miembros[Edad])),0)
		lineageTag: a299711b-9ae0-45ba-afb5-c6416d296e4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

