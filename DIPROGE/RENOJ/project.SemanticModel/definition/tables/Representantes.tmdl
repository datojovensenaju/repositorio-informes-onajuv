table Representantes
	lineageTag: ceb5480b-155b-426d-abc3-c007e4f77a5e

	measure 'Total de Organizaciones' = COUNTROWS(Representantes)
		formatString: 0
		lineageTag: eda87b6e-eb38-46c0-8abb-fd4c4d18fb74

	measure 'Tarjeta Organización' =
			
			IF(
			    NOT HASONEVALUE(Representantes[ORGANIZACIÓN JUVENIL O INSTITUCIÓN (PÚBLICA O PRIVADA)]),
			    "Selecciona una organización",
			    SELECTEDVALUE(Representantes[ORGANIZACIÓN JUVENIL O INSTITUCIÓN (PÚBLICA O PRIVADA)])
			)
		lineageTag: c386bd9e-a451-4724-9e02-e5334a1e7742

	measure 'Medio Digital de Organización' =
			
			IF(
			    NOT HASONEVALUE(Representantes[MEDIO DE VERIFICACIÓN]),
			    "-",
			    SELECTEDVALUE(Representantes[MEDIO DE VERIFICACIÓN])
			)
		lineageTag: 8631ff59-e4c1-4848-a47d-591fc25de418

	measure 'Tarjeta Región' =
			
			IF(
			    NOT HASONEVALUE(dimRegion[REGION]),
			    "NACIONAL",
			    SELECTEDVALUE(dimRegion[REGION])
			)
		lineageTag: 4319494a-e00b-4092-baf7-ccedd236ce9b

	measure 'Total sin filtros' = CALCULATE(COUNTROWS(Representantes), ALL(Representantes))
		formatString: 0
		lineageTag: e667faa6-9eb7-4b30-bfe9-5ff5e3bd8c90

