table fact_movilizacion
	lineageTag: 73684cc0-63b1-465f-b971-ec3fae319039

	measure Porcentaje_Movilizacion =
			
			DIVIDE(
			    [Total_movilizacion],
			    [Total Voluntarios]
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 9f54dae7-f621-4d05-b83a-3e3c538222bc

	measure Total_movilizacion = SUM(fact_movilizacion[VOLUNTARIOS_MOVILIZADOS])
		formatString: 0
		lineageTag: ff00f74f-b331-4f59-961c-b2df6b7cd606

