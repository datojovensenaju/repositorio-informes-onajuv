table fact_Voluntarios
	lineageTag: 2f9ebaf4-f203-4c20-b915-b8ace42250e6

	measure 'Total Voluntarios' =
			VAR voluntarios = COUNTROWS(fact_Voluntarios)
			RETURN
			IF(
			    voluntarios>0,
			    voluntarios,
			    "-")
		lineageTag: 7ec8ae16-0f1f-4b44-b9a1-931d0ecbf228

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosPeru =
			
			VAR FiltroResidePeru =
			    SELECTEDVALUE(fact_Voluntarios[RESIDE_PERU])
			
			VAR VoluntariosPeru =
			    CALCULATE(
			        COUNTROWS(fact_Voluntarios),
			        fact_Voluntarios[RESIDE_PERU] = "SI"
			    )
			RETURN
			IF(
			    FiltroResidePeru = "NO",
			    "-",
			    IF(
			        VoluntariosPeru > 0,
			        VoluntariosPeru,
			        "-"
			    )
			)
		lineageTag: 35a09f3a-2f12-481e-a563-567ec7dbf8be

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosExtranjero =
			
			VAR FiltroResidePeru =
			    SELECTEDVALUE(fact_Voluntarios[RESIDE_PERU])
			
			VAR VoluntariosExtranjero =
			    CALCULATE(
			        COUNTROWS(fact_Voluntarios),
			        fact_Voluntarios[RESIDE_PERU] = "NO"
			    )
			
			RETURN
			IF(
			    FiltroResidePeru = "SI",
			    "-",
			    IF(
			        VoluntariosExtranjero > 0,
			        VoluntariosExtranjero,
			        "-"
			    )
			)
		lineageTag: 1eabe6d8-c118-44a4-aa68-72e4224ac8d2

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosPeruHombre =
			VAR VoluntariosPeruHombre =
			    CALCULATE(
			        [Total Voluntarios],
			        fact_Voluntarios[RESIDE_PERU] = "SI",
			        Sexo[SEXO]="HOMBRE"
			    )
			RETURN
			IF(
			    VoluntariosPeruHombre > 0,
			    VoluntariosPeruHombre,
			    "-"
			)
		lineageTag: 85e17a82-492c-498d-9dbd-bcc78d6d7806

		formatStringDefinition = "### ### ###"

	measure VoluntariosExperiencia =
			VAR VoluntariosExperiencia =
			    CALCULATE(
			        [Total Voluntarios],
			        fact_Voluntarios[EXPERIENCIA_VOLUNTARIADO] = "SI"
			    )
			RETURN
			IF(
			    VoluntariosExperiencia > 0,
			    VoluntariosExperiencia,
			    "-"
			)
		lineageTag: a348cc9f-e517-4488-8815-e5f37bea5b86

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosPeruMujer =
			VAR VoluntariosPeruMujer =
			    CALCULATE(
			        [Total Voluntarios],
			        fact_Voluntarios[RESIDE_PERU] = "SI",
			        Sexo[SEXO]="MUJER"
			    )
			RETURN
			IF(
			    VoluntariosPeruMujer > 0,
			    VoluntariosPeruMujer,
			    "-"
			)
		lineageTag: d108a142-453e-43bd-a3d7-330be4f14dbe

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosExtranjeroHombre =
			VAR VoluntariosExtranjeroHombre =
			    CALCULATE(
			        [Total Voluntarios],
			        fact_Voluntarios[RESIDE_PERU] = "NO",
			        Sexo[SEXO]="HOMBRE"
			    )
			RETURN
			IF(
			    VoluntariosExtranjeroHombre > 0,
			    VoluntariosExtranjeroHombre,
			    "-"
			)
		lineageTag: d2c80056-99e5-43f9-8453-2c1d9d27c2e1

		formatStringDefinition = "### ### ###"

	measure totalVoluntariosExtranjeroMujer =
			VAR VoluntariosExtranjeroMujer =
			    CALCULATE(
			        [Total Voluntarios],
			        fact_Voluntarios[RESIDE_PERU] = "NO",
			        Sexo[SEXO]="MUJER"
			    )
			RETURN
			IF(
			    VoluntariosExtranjeroMujer > 0,
			    VoluntariosExtranjeroMujer,
			    "-"
			)
		lineageTag: 6b2b536f-3d83-499b-913f-f4b98578ad7b

		formatStringDefinition = "### ### ###"

	measure Porcentaje_Area =
			
			DIVIDE(
			    COUNTROWS(fact_Voluntarios),
			    CALCULATE(
			        COUNTROWS(fact_Voluntarios),
			        ALL(fact_Voluntarios[AREA_ESTANDARIZADA])
			    )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: d97941d0-b4d5-40a8-ab83-d65ed6deb01f

	measure Porcentaje_Ocupacion =
			
			DIVIDE(
			    COUNTROWS(fact_Voluntarios),
			    CALCULATE(
			        COUNTROWS(fact_Voluntarios),
			        ALL('Nivel Ocupacional'[NIVEL_OCUPACIONAL])
			    )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: da50505d-d5fa-4f01-b001-e9821ea52b13

	measure Porcentaje_Educacion =
			
			DIVIDE(
			    COUNTROWS(fact_Voluntarios),
			    CALCULATE(
			        COUNTROWS(fact_Voluntarios),
			        ALL('Nivel Educativo'[NIVEL_EDUCATIVO])
			    )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 81eabe7a-f1f0-4cfb-af19-26f19830b00e

