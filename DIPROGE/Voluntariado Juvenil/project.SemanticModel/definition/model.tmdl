model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Edad","Nivel Educativo","Nivel Ocupacional","Sexo","dimDepartamento","dimRegion","dimProvincia","dimDistrito","fact_Voluntarios","fact_movilizacion"]

annotation PBI_ProTooling = ["DevMode"]

ref table Edad
ref table 'Nivel Educativo'
ref table 'Nivel Ocupacional'
ref table Sexo
ref table dimDepartamento
ref table dimRegion
ref table dimProvincia
ref table dimDistrito
ref table fact_Voluntarios
ref table fact_movilizacion

ref cultureInfo es-MX

